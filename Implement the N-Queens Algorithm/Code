def dfs_n_queens(n):

    solution = []
    if n < 1:
        return []

    def is_safe(board, row, col):
        for r, c in enumerate(board):
            if c == col or r + c == row + col or r - c == row - col:
                return False
        return True
    def solve(row, current_board):
        if row == n:
            solution.append(current_board)
        else:
            for col in range(n):
                if is_safe(current_board, row, col):
                    solve(row + 1, current_board + [col])
    solve(0, [])
    return solution

print(dfs_n_queens(5))
