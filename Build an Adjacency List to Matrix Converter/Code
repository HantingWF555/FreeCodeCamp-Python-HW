def adjacency_list_to_matrix(dic):
    n = len(dic)
    matrix = [[0 for _ in range(n)] for _ in range(n)]

    for node, neigh in dic.items():
        for neigh in neigh:
            matrix[node][neigh] = 1

    for row in matrix:
        print(row)
    return matrix



print(adjacency_list_to_matrix({0: [2], 1: [2, 3], 2: [0, 1, 3], 3: [1, 2]}))
